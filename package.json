{
  "name": "obsidian-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-next-vary.mjs",
    "predev": "node scripts/patch-next-vary.mjs && npm run registry:build && npm run agent:build",
    "dev": "next dev",
    "build": "node scripts/patch-next-vary.mjs && npm run registry:build && npm run agent:build && next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:components": "vitest run",
    "registry:build": "tsx scripts/build-registry.ts",
    "agent:build": "tsx scripts/build-agent-docs.ts",
    "golden-gate:build": "tsx scripts/build-golden-gate.ts",
    "verify:agents": "tsx scripts/verify-agent-endpoints.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "r2:upload": "node scripts/upload-r2.mjs",
    "r2:dry": "node scripts/upload-r2.mjs --dry-run",
    "sync:r2-manifest": "node -e \"require('fs').copyFileSync('scripts/r2-manifest.json','src/lib/r2-manifest.json');console.log('r2-manifest synced to src/lib/');\""
  },
